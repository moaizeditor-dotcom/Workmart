# ==============================================================================
# WORKMARK / WORKMART PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & API Ports
PORT=3001
APP_URL=http://localhost:3000

# Persistent Turso/libSQL database. Required in Netlify unless DATABASE_URL is set.
# Create a database and auth token with Turso; keep both server-side only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional managed PostgreSQL alternative. If both database URLs are configured,
# DATABASE_URL takes precedence.
DATABASE_URL=

# Generate a unique random value for each environment (at least 32 characters).
# Required in Netlify production; never expose as a VITE_* variable.
# Example: openssl rand -base64 48
JWT_SECRET=

# ==============================================================================
# ADMINISTRATOR CONTROL TOWER CREDENTIALS
# ==============================================================================
# Used to authenticate at the Admin Control Tower modal.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ==============================================================================
# OAUTH PROVIDER CREDENTIALS
# ==============================================================================
# To enable real Google, GitHub, and Twitter sign in, obtain OAuth client credentials
# from each developer portal and configure the exact callback URIs specified below.

# 1. GOOGLE OAUTH
# Developer Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production redirect URI: https://workmak.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2. GITHUB OAUTH
# Developer Settings: https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Production callback URL: https://workmak.netlify.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 3. TWITTER / X OAUTH 2.0
# Developer Portal: https://developer.twitter.com/en/portal/dashboard
# Callback URI / Redirect URL: http://localhost:3000/api/auth/callback/twitter
# Production callback URL: https://workmak.netlify.app/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Local SQLite file override. Do not use this for Netlify production; serverless
# local files are temporary. Use Turso/libSQL for persistent SQLite-compatible storage.
DATABASE_PATH=
